{
  "name": "ai-image-detector",
  "version": "1.0.0",
  "description": "Privacy-preserving AI image detector: Chrome MV3 extension with 100% in-browser inference (WebGPU/WASM). No cloud, no servers, no tracking.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "cover": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench:fetch": "node bench/fetch-dataset.mjs",
    "bench": "node bench/run.mjs",
    "bench:report": "node bench/metrics.mjs",
    "models:manifest": "node tools/verify-manifest.mjs",
    "pack": "node tools/pack.mjs",
    "docs:sync": "node tools/sync-docs.mjs",
    "docs:check": "node tools/sync-docs.mjs --check",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@vitest/coverage-v8": "3.2.7",
    "esbuild": "0.28.2",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "onnxruntime-node": "1.22.0",
    "prettier": "3.6.2",
    "puppeteer": "24.16.2",
    "sharp": "0.35.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "fft.js": "4.0.4",
    "linkedom": "0.18.13",
    "onnxruntime-web": "1.22.0"
  }
}
