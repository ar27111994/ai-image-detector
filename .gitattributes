# Normalize line endings: LF in the repo, platform-native in the working tree.
# This prevents spurious "modified" markers on Windows (CRLF) checkouts.
* text=auto

# Force LF for shell/CI-sensitive and source files
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.py    text eol=lf
*.txt   text eol=lf

# Binary assets
*.png   binary
*.onnx  binary
*.wasm  binary
*.zip   binary
